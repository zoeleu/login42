# login42 web service on Bun. Built on the VPS by the login42.build Quadlet (context: this directory).
FROM docker.io/oven/bun:1.4.4-alpine
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production
COPY src ./src
COPY migrations ./migrations
COPY scripts ./scripts
# A new named volume is seeded from this directory, so the unprivileged user can write the database.
RUN mkdir -p /data && chown bun:bun /data
USER bun
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 DB_PATH=/data/login42.sqlite
EXPOSE 8787
CMD ["bun", "src/server.ts"]
