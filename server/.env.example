# Copy to .env (git-ignored) for local runs; on the VPS this file is ~/projects/login42/.env (mode 600).
# Required: the service refuses to start without these.
PUBLIC_URL=http://127.0.0.1:8787
FT_CLIENT_ID=
FT_CLIENT_SECRET=
PLUGIN_HMAC_SECRET=
ADMIN_TOKEN=
# Optional: without it, skin upload is disabled (premium skins still work).
MINESKIN_API_KEY=
# host:port players connect to for the one-time premium proof. Empty hides premium linking.
VERIFIER_ADDRESS=
LIMBO_PER_MINUTE=12
TOKEN_TTL_SECONDS=120
ALLOW_STAFF=false
# Shown on /privacidade and /privacy as the LGPD contact channel.
PRIVACY_CONTACT=
# SQLite database file; the container sets /data/login42.sqlite.
DB_PATH=login42.sqlite
HOST=127.0.0.1
PORT=8787
